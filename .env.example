# متغيرات البيئة المطلوبة للتشغيل
# انسخ هذا الملف إلى .env وقم بتعبئة القيم

# إعدادات Google OAuth للمصادقة
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://your-project-name.vercel.app

# إعدادات Firebase (اختياري - يمكن وضعها في app.js مباشرة)
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# FIREBASE_APP_ID=your_app_id

# إعدادات أخرى
NODE_ENV=development
PORT=3000
